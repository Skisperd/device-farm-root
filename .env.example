# Copy to .env and adjust. The .env file is git-ignored.

# Appium hub port
APPIUM_PORT=4723

# Device Farm version (appium-device-farm npm package)
DEVICE_FARM_VERSION=12.0.2

# Number of headless emulators to start with "make emulators-up"
EMULATORS=2

# Optional: pick specific devices from the catalog (comma-separated ids from infra/emulators/devices.conf)
EMULATOR_DEVICES=

# TCP devices the hub should connect to (filled automatically by emulators-up).
# Add Wi-Fi device IPs here: 192.168.1.20:5555
ADB_CONNECT_DEVICES=

# Host directory with adb keys (so hub reuses host's device authorisations)
HOST_ADB_KEYS_DIR=

# Lock screen PIN set on emulators (some apps require a screen lock)
EMULATOR_PIN=1234

# Extra RAM per emulator in MB (overrides catalog value)
EMULATOR_RAM_MB=

# Extra Appium server arguments
APPIUM_EXTRA_ARGS=

# Record video of sessions in the device-farm dashboard
RECORD_VIDEO=false
